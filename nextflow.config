docker.enabled = true
workflow.output.mode = 'copy'

executor {
    cpus   = 14
    memory = '26 GB'
}

process {
    cpus      = 2
    memory    = '2 GB'    
    container = 'depth-vs-replicates:0.2'

    withName: KALLISTO_QUANT {
        cpus   = 3       
        memory = '5 GB'  
    }
}

profiles {
test {
    params.sra_run_table = 'metadata/SraRunTable.csv'
    params.urls          = 'metadata/urls.txt'
    params.md5           = 'metadata/ena_md5.tsv'
    params.cdna  = 'https://ftp.ensembl.org/pub/release-116/fasta/homo_sapiens/cdna/Homo_sapiens.GRCh38.cdna.all.fa.gz'
    params.ncrna = 'https://ftp.ensembl.org/pub/release-116/fasta/homo_sapiens/ncrna/Homo_sapiens.GRCh38.ncrna.fa.gz'
    params.depths = [2500000, 5000000, 10000000, 15000000, 20000000, 25000000]
    params.frag_len = 200
    params.frag_sd  = 20
    params.n_draws    = 1
    params.replicates = [2, 3]
    outputDir = 'results_test'
}

    full {
        params.samplesheet = 'sample_sheets/samplesheet_all.csv'
        params.sra_run_table = 'metadata/SraRunTable.csv'
        params.urls = 'metadata/urls.txt'
        params.md5 = 'metadata/ena_md5.tsv'
        params.index       = 'ref/ensembl_r116.idx'
        params.cdna = 'https://ftp.ensembl.org/pub/release-116/fasta/homo_sapiens/cdna/Homo_sapiens.GRCh38.cdna.all.fa.gz'
        params.ncrna = 'https://ftp.ensembl.org/pub/release-116/fasta/homo_sapiens/ncrna/Homo_sapiens.GRCh38.ncrna.fa.gz'
        params.depths = [2500000, 5000000, 10000000, 15000000, 20000000, 25000000]
        params.outdir      = 'results'
        // Single-end reads: kallisto needs the fragment length distribution
        params.frag_len    = 200
        params.frag_sd     = 20
        params.n_draws = 20
        params.replicates = [2, 3, 4, 5, 6, 7]
    }
}
