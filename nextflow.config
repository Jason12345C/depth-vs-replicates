docker.enabled = true

executor {
    cpus   = 14
    memory = '26 GB'
}

process {
    cpus      = 2
    memory    = '2 GB'    
    container = 'depth-vs-replicates:0.1'

    withName: KALLISTO_QUANT {
        cpus   = 3       
        memory = '5 GB'  
    }
}

profiles {
    test {
        params.samplesheet = 'sample_sheets/samplesheet.csv'
        params.index       = 'ref/ensembl_r116.idx'
        params.depths = [2500000]
        params.outdir      = 'test'
        // Single-end reads: kallisto needs the fragment length distribution
        params.frag_len    = 200
        params.frag_sd     = 20
    }

    full {
        params.samplesheet = 'sample_sheets/samplesheet_all.csv'
        params.index       = 'ref/ensembl_r116.idx'
        params.depths = [2500000, 5000000, 10000000, 15000000, 20000000, 25000000]
        params.outdir      = 'results'
        // Single-end reads: kallisto needs the fragment length distribution
        params.frag_len    = 200
        params.frag_sd     = 20
    }
}
